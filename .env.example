# Local test / tooling environment. NEVER commit the real file.
# Nothing in here is read by the browser - the frontend only ever sees
# js/config.js (Supabase URL + publishable anon key + Google client ID).

# --- used by `npm run test:security` (live RLS tier) ------------------
# Use a SCRATCH project: the suite creates and deletes users.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # secret: test machines only

# --- used by `supabase secrets set` for the edge function -------------
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
NCKU_HOSTED_DOMAIN=gs.ncku.edu.tw
# Required. Unset, the function refuses every request instead of replying
# with Access-Control-Allow-Origin: *.
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.netlify.app

# The Google OAuth *client secret* belongs in the Supabase dashboard only.
# It must never appear in this repository or in any deployed asset.
#  Cmk1vvkmmnkPVYU9
# npx supabase@latest link --project-ref rlsmoumqqnggfqeifhgt